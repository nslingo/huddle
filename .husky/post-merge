# After a pull/merge that touched the lockfile, bring dependencies up to date. Runs from the git
# root, where pnpm-lock.yaml lives and where `pnpm install` resolves the whole workspace.
changed() {
    git diff --name-only HEAD@{1} HEAD | grep "^$1" >/dev/null 2>&1
}

if changed 'pnpm-lock.yaml'; then
    echo "📦 pnpm-lock.yaml changed — running pnpm install."
    pnpm install
fi